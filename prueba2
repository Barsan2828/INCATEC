    // Al hacer clic en una pestaña, cambia de color y se mantiene marcada como activa
    const links = document.querySelectorAll('#navBar a');
    links.forEach(link => {
      link.addEventListener('click', function(e){
        e.preventDefault();
        links.forEach(l => l.classList.remove('active'));
        this.classList.add('active');
      });
    });

    // ===== Botones Matricúlate / Soy estudiante =====
    const topBtns = document.querySelectorAll('#topButtons .btn-pill');
    topBtns.forEach(btn => {
      btn.addEventListener('click', function(){
        this.classList.toggle('on');
      });
    });

    // ===== Widget de chat Aukán =====
    const aukanWidget = document.getElementById('aukanWidget');
    const aukanToggle = document.getElementById('aukanToggle');
    const aukanClose = document.getElementById('aukanClose');
    const aukanBody = document.getElementById('aukanBody');

    aukanToggle.addEventListener('click', () => {
      aukanWidget.classList.toggle('abierto');
      if(aukanWidget.classList.contains('abierto') && aukanBody.childElementCount === 0){
        mostrarMenuPrincipal();
      }
    });
    aukanClose.addEventListener('click', () => {
      aukanWidget.classList.remove('abierto');
    });

    function aukanLimpiar(){
      aukanBody.innerHTML = '';
    }

    function aukanMensaje(texto){
      const msg = document.createElement('div');
      msg.className = 'aukan-msg-bot';
      msg.innerHTML = texto;
      aukanBody.appendChild(msg);
    }

    function aukanOpciones(botones){
      const cont = document.createElement('div');
      cont.className = 'aukan-opciones';
      botones.forEach(b => {
        const btn = document.createElement('button');
        if(b.volver) btn.classList.add('aukan-volver');
        btn.textContent = b.texto;
        btn.addEventListener('click', b.accion);
        cont.appendChild(btn);
      });
      aukanBody.appendChild(cont);
      aukanBody.scrollTop = aukanBody.scrollHeight;
    }

    function mostrarMenuPrincipal(){
      aukanLimpiar();
      aukanMensaje('¡Hola! 👋 Soy <strong>Aukán</strong>, tu guía en INCATEC. ¿En qué te puedo ayudar hoy?');
      aukanOpciones([
        { texto: '🎓 Programas', accion: mostrarProgramas },
        { texto: '🕐 Jornadas', accion: mostrarJornadas },
        { texto: '💰 Costo', accion: mostrarCosto },
        { texto: '📍 Sedes', accion: mostrarSedes },
      ]);
    }

    function botonVolver(){
      return { texto: '⬅ Volver al menú', volver: true, accion: mostrarMenuPrincipal };
    }

    function mostrarProgramas(){
      aukanLimpiar();
      aukanMensaje('Tenemos 7 escuelas con más de 40 programas técnicos laborales. Puedes ver el listado completo aquí:');
      const cont = document.createElement('div');
      cont.className = 'aukan-opciones';
      const link = document.createElement('a');
      link.href = 'programas.html';
      link.textContent = 'Ver todos los programas →';
      link.style.cssText = 'display:block;background:var(--azul-2);color:#fff;text-align:center;padding:10px 14px;border-radius:20px;text-decoration:none;font-weight:600;font-size:12.5px;';
      cont.appendChild(link);
      aukanBody.appendChild(cont);
      aukanOpciones([ botonVolver() ]);
    }

    function mostrarJornadas(){
      aukanLimpiar();
      aukanMensaje('Manejamos <strong>3 jornadas</strong>:<br><br>☀️ Diurna: 7:00 a.m. – 1:00 p.m.<br>🌙 Nocturna: 6:00 p.m. – 9:00 p.m.<br>📅 Sabatina: 7:00 a.m. – 6:00 p.m.');
      aukanOpciones([ botonVolver() ]);
    }

    function mostrarCosto(){
      aukanLimpiar();
      aukanMensaje('Los costos varían según el programa y la sede. Para darte información exacta, lo mejor es comunicarte directamente con nosotros 📞');
      aukanOpciones([ botonVolver() ]);
    }

    function mostrarSedes(){
      aukanLimpiar();
      aukanMensaje('Contamos con 2 sedes:<br><br>📍 Facatativá, Cundinamarca<br>📍 Madrid, Cundinamarca');
      aukanOpciones([ botonVolver() ]);
    }
  </script>

</body>
</html>
