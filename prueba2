<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<title>Header Campoalto</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --azul-1:#0a1a5c;
    --azul-2:#1c3fae;
    --amarillo:#D4AF37;
    --amarillo-hover:#b8952d;
    --blanco:#ffffff;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  body{font-family:'Poppins', Arial, Helvetica, sans-serif;}

  /* ===== Mini barra superior (PQRSFD) ===== */
  .mini-bar{
    background:#0a1230;
    display:flex;
    justify-content:flex-end;
    padding:6px 40px;
  }
  .mini-bar a{
    color:var(--blanco);
    font-family:'Poppins', sans-serif;
    font-size:12px;
    text-decoration:none;
    letter-spacing:.5px;
  }
  .mini-bar a:hover{
    color:var(--amarillo);
  }

  /* ===== Barra superior ===== */
  .top-bar{
    background:linear-gradient(135deg, var(--azul-1) 0%, var(--azul-2) 100%);
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 40px;
    flex-wrap:wrap;
    gap:16px;
  }

  .logo-area{
    display:flex;
    align-items:center;
    gap:14px;
    color:var(--blanco);
  }
  .logo-area img{height:120px; margin-top:14px;}

  .top-right{
    display:flex;
    align-items:center;
    gap:24px;
  }

  /* ===== Botones tipo píldora (Matricúlate / Soy estudiante) ===== */
  .top-buttons{
    display:flex;
    align-items:center;
    gap:12px;
  }
  .btn-pill{
    display:inline-block;
    border:none;
    cursor:pointer;
    font-family:'Poppins', sans-serif;
    font-weight:600;
    font-size:14px;
    padding:11px 26px;
    border-radius:8px;
    background:linear-gradient(180deg, #f7c85f 0%, #e8a93a 100%);
    color:#1a1a2e;
    box-shadow:0 3px 8px rgba(0,0,0,.25);
    transition:background .25s ease, transform .15s ease, color .25s ease;
    white-space:nowrap;
  }
  .btn-pill:hover{
    transform:translateY(-2px);
  }
  .btn-pill.on{
    background:linear-gradient(180deg, var(--azul-2) 0%, var(--azul-1) 100%);
    color:var(--blanco);
  }

  .search-box{
    display:flex;
    align-items:center;
  }
  .search-box input{
    height:40px;
    width:200px;
    border:none;
    padding:0 14px;
    font-size:13px;
    font-family:'Poppins', sans-serif;
    background:#e9e9e9;
    border-radius:6px 0 0 6px;
  }
  .search-box button{
    height:40px;
    width:44px;
    background:var(--amarillo);
    border:none;
    color:var(--blanco);
    font-size:15px;
    border-radius:0 6px 6px 0;
    cursor:pointer;
    transition:background .2s ease;
  }
  .search-box button:hover{background:var(--amarillo-hover);}

  /* ===== Menú de navegación ===== */
  .nav-bar{
    background:linear-gradient(90deg, #e8c34a 0%, var(--amarillo) 50%, #b8862a 100%);
    display:flex;
    flex-wrap:wrap;
    justify-content:flex-end;
  }
  .nav-bar a{
    color:var(--blanco);
    text-decoration:none;
    font-size:16px;
    font-weight:700;
    padding:14px 20px;
    border-right:1px solid rgba(255,255,255,.35);
    display:flex;
    align-items:center;
    gap:6px;
    white-space:nowrap;
    transition:background .2s ease, color .2s ease;
  }
  .nav-bar a:last-child{border-right:none;}
  .nav-bar a:hover{background:var(--amarillo-hover);}

  /* Estado activo al hacer clic */
  .nav-bar a.active{
    background:var(--azul-1);
    color:var(--blanco);
  }

  /* ===== Banner / Slider ===== */
  .hero-banner{
    position:relative;
    overflow:hidden;
    min-height:170px;
    background:#0a1230;
  }

  .slide{
    position:absolute;
    inset:0;
    opacity:0;
    visibility:hidden;
    transition:opacity .6s ease;
    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
  }
  .slide.active{
    opacity:1;
    visibility:visible;
    position:relative;
  }

  /* Slide 1 - fondo blanco */
  .slide-1{
    background-color:#ffffff;
    background-image:url('banner1-blanco.png');
  }

  /* Slide 3 - fondo azul con movimiento */
  .slide-3{
    background-color:#14206b;
    background-image:url('banner3-azul.png');
  }
  .slide-3 .glow{
    position:absolute;
    inset:0;
    pointer-events:none;
    overflow:hidden;
  }
  .slide-3 .glow span{
    position:absolute;
    border-radius:50%;
    filter:blur(2px);
    opacity:.55;
    background:radial-gradient(circle, rgba(255,255,255,.9) 0%, rgba(255,255,255,0) 70%);
    animation:flotar 6s ease-in-out infinite;
  }
  .slide-3 .glow span:nth-child(1){ width:70px; height:70px; top:15%; left:8%; animation-delay:0s; }
  .slide-3 .glow span:nth-child(2){ width:40px; height:40px; top:65%; left:20%; animation-delay:1.2s; }
  .slide-3 .glow span:nth-child(3){ width:55px; height:55px; top:30%; left:92%; animation-delay:.6s; }
  .slide-3 .glow span:nth-child(4){ width:30px; height:30px; top:75%; left:85%; animation-delay:2s; }
  .slide-3 .glow span:nth-child(5){ width:90px; height:90px; top:5%; left:55%; animation-delay:.3s; }

  @keyframes flotar{
    0%,100%{ transform:translateY(0) scale(1); opacity:.55; }
    50%{ transform:translateY(-18px) scale(1.15); opacity:.9; }
  }

  .slide-3 img.mascota-mov{
    animation:balanceo 3s ease-in-out infinite;
    transform-origin:bottom center;
  }
  @keyframes balanceo{
    0%,100%{ transform:rotate(0deg); }
    50%{ transform:rotate(2deg); }
  }

  /* Slide 4 */
  .slide-4{
    background-color:#ffffff;
    background-image:url('banner4.png');
  }

  /* Ajusta la relación de aspecto según el tamaño real de tus banners */
  .slide-inner{
    width:100%;
    padding-top:26.04%; /* proporción ~960x250 */
  }

  .hero-arrow{
    position:absolute;
    top:50%;
    transform:translateY(-50%);
    z-index:4;
    background:rgba(0,0,0,.35);
    color:var(--blanco);
    border:none;
    width:40px;
    height:40px;
    border-radius:50%;
    font-size:20px;
    cursor:pointer;
    display:flex;
    align-items:center;
    justify-content:center;
  }
  .hero-arrow.left{ left:14px; }
  .hero-arrow.right{ right:14px; }
  .hero-arrow:hover{ background:rgba(0,0,0,.55); }

  .hero-dots{
    position:absolute;
    top:16px;
    right:20px;
    z-index:4;
    display:flex;
    gap:8px;
    align-items:center;
  }
  .hero-dots button{
    width:26px;
    height:26px;
    border-radius:50%;
    border:none;
    background:rgba(255,255,255,.15);
    color:var(--blanco);
    font-size:12px;
    font-family:'Poppins', sans-serif;
    cursor:pointer;
  }
  .hero-dots button.active{
    background:var(--amarillo);
    color:var(--azul-1);
    font-weight:700;
  }
  .hero-dots .pause{
    background:rgba(255,255,255,.15);
  }

  /* ===== Barra de datos inferior ===== */
  .stats-bar{
    background:#0a1230;
    display:flex;
    flex-wrap:wrap;
    justify-content:center;
    gap:60px;
    padding:22px 30px;
  }
  .stats-bar .item{
    color:var(--blanco);
    font-family:'Poppins', sans-serif;
    font-size:14px;
    white-space:nowrap;
  }
  .stats-bar .item strong{
    color:var(--amarillo);
    font-weight:700;
    margin-right:6px;
  }  /* ===== Sección ¿Por qué elegirnos? ===== */
  .elegirnos-section{
    background:linear-gradient(135deg, var(--azul-1) 0%, var(--azul-2) 100%);
    padding:55px 60px 65px;
  }
  .elegirnos-tag{
    display:flex;
    align-items:center;
    gap:10px;
    color:var(--amarillo);
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:13px;
    letter-spacing:2px;
    margin-bottom:14px;
  }
  .elegirnos-tag .linea{
    width:26px;
    height:2px;
    background:var(--amarillo);
    display:inline-block;
  }
  .elegirnos-section h2{
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:32px;
    color:var(--blanco);
    line-height:1.25;
    margin-bottom:16px;
    max-width:640px;
  }
  .elegirnos-section p.elegirnos-desc{
    font-family:'Poppins', sans-serif;
    font-size:15px;
    color:#d7dcf5;
    max-width:640px;
    line-height:1.6;
    margin-bottom:40px;
  }

  .elegirnos-grid{
    display:grid;
    grid-template-columns:repeat(2, 1fr);
    gap:24px;
    max-width:1100px;
  }
  @media (max-width:700px){
    .elegirnos-grid{ grid-template-columns:1fr; }
  }

  .elegirnos-card{
    background:rgba(255,255,255,.06);
    border:1px solid rgba(255,255,255,.18);
    border-radius:14px;
    padding:30px 28px;
    cursor:pointer;
    transition:transform .25s ease, background .25s ease, border-color .25s ease, box-shadow .25s ease;
  }
  .elegirnos-icono{
    width:46px;
    height:46px;
    border-radius:12px;
    background:linear-gradient(180deg, #f7c85f 0%, #e8a93a 100%);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:22px;
    margin-bottom:18px;
    transition:background .25s ease;
  }
  .elegirnos-card h3{
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:17px;
    color:var(--blanco);
    margin-bottom:10px;
    transition:color .25s ease;
  }
  .elegirnos-card p{
    font-family:'Poppins', sans-serif;
    font-size:14px;
    color:#c9cfec;
    line-height:1.6;
    transition:color .25s ease;
  }

  .elegirnos-card:hover{
    transform:translateY(-4px);
  }

  /* Estado activo al hacer clic: resaltado + cambio de color */
  .elegirnos-card.activo{
    background:var(--amarillo);
    border-color:var(--amarillo);
    box-shadow:0 14px 30px rgba(212,175,55,.35);
    transform:translateY(-4px) scale(1.02);
  }
  .elegirnos-card.activo .elegirnos-icono{
    background:var(--azul-1);
  }
  .elegirnos-card.activo h3{
    color:var(--azul-1);
  }
  .elegirnos-card.activo p{
    color:#1a2340;
  }

  /* ===== Footer ===== */
  .site-footer{
    background:#0a1230;
    padding:50px 60px 35px;
    color:#c9cfe3;
  }
  .footer-top{
    display:grid;
    grid-template-columns:1.4fr 1fr 1fr 1fr 1fr;
    gap:30px;
  }
  @media (max-width:900px){
    .footer-top{ grid-template-columns:1fr 1fr; }
  }
  @media (max-width:520px){
    .footer-top{ grid-template-columns:1fr; }
  }

  .footer-brand img{ height:60px; margin-bottom:16px; }
  .footer-brand p{
    font-family:'Poppins', sans-serif;
    font-size:13px;
    line-height:1.6;
    color:#aab0cc;
    margin-bottom:18px;
  }
  .footer-brand .direccion{
    font-family:'Poppins', sans-serif;
    font-size:13px;
    line-height:1.6;
    color:#aab0cc;
    margin-bottom:14px;
  }

  .footer-col h4{
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:14px;
    color:var(--blanco);
    margin-bottom:16px;
  }
  .footer-col a{
    display:block;
    font-family:'Poppins', sans-serif;
    font-size:13.5px;
    color:#aab0cc;
    text-decoration:none;
    margin-bottom:12px;
    transition:color .2s ease;
  }
  .footer-col a:hover{
    color:var(--amarillo);
  }

  .footer-bottom{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    flex-wrap:wrap;
    gap:24px;
    margin-top:40px;
  }

  .footer-social span{
    display:flex;
    align-items:center;
    gap:8px;
    font-family:'Poppins', sans-serif;
    font-weight:600;
    font-size:13px;
    color:var(--blanco);
    margin-bottom:12px;
  }
  .footer-social span::before{
    content:"";
    width:8px;
    height:8px;
    border-radius:50%;
    background:var(--amarillo);
    display:inline-block;
    flex-shrink:0;
  }
  .footer-social-icons{
    display:flex;
    gap:10px;
  }
  .footer-social-icons a{
    width:34px;
    height:34px;
    border-radius:50%;
    background:#2952d6;
    display:flex;
    align-items:center;
    justify-content:center;
    color:var(--blanco);
    text-decoration:none;
    transition:transform .2s ease, background .2s ease;
  }
  .footer-social-icons a svg{
    display:block;
  }
  .footer-social-icons a:hover{
    transform:translateY(-3px);
    background:var(--amarillo);
  }

  .footer-cert img{
    height:70px;
    background:#fff;
    border-radius:8px;
    padding:6px 10px;
  }

  /* ===== Sección A quiénes llegamos (contadores) ===== */
  .stats-counter-section{
    background:linear-gradient(135deg, #0a1230 0%, var(--azul-1) 100%);
    padding:50px 60px 55px;
  }
  .stats-counter-title{
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:22px;
    color:var(--blanco);
    display:inline-block;
    position:relative;
    padding-bottom:14px;
    margin-bottom:36px;
  }
  .stats-counter-title::after{
    content:"";
    position:absolute;
    left:0;
    bottom:0;
    width:60px;
    height:3px;
    background:var(--amarillo);
  }

  .stats-counter-grid{
    display:flex;
    flex-wrap:wrap;
    justify-content:space-between;
    gap:20px;
  }
  .stat-counter-item{
    flex:1;
    min-width:150px;
    text-align:center;
    padding:0 14px;
    border-right:1px solid rgba(255,255,255,.18);
  }
  .stat-counter-item:last-child{ border-right:none; }
  @media (max-width:800px){
    .stat-counter-item{ flex:1 1 40%; border-right:none; margin-bottom:20px; }
  }

  .stat-counter-number{
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:44px;
    color:var(--amarillo);
    line-height:1.1;
  }
  .stat-counter-label{
    font-family:'Poppins', sans-serif;
    font-size:14px;
    color:#cfd4ec;
    margin-top:8px;
  }

  /* ===== Sección Nuestros Aliados (marquee de logos) ===== */
  .aliados-section{
    background:#ffffff;
    padding:45px 0 55px;
    position:relative;
  }
  .aliados-title{
    text-align:center;
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:24px;
    color:#111;
    position:relative;
    padding-bottom:14px;
    margin-bottom:36px;
  }
  .aliados-title::after{
    content:"";
    position:absolute;
    left:50%;
    bottom:0;
    transform:translateX(-50%);
    width:60px;
    height:3px;
    background:var(--amarillo);
  }

  .marquee-wrapper{
    position:relative;
    overflow:hidden;
    width:100%;
    -webkit-mask-image:linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
    mask-image:linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
  }

  .marquee-track{
    display:flex;
    align-items:center;
    width:max-content;
    animation:marquee-scroll 32s linear infinite;
  }
  .marquee-wrapper:hover .marquee-track{
    animation-play-state:paused;
  }

  @keyframes marquee-scroll{
    0%{ transform:translateX(0); }
    100%{ transform:translateX(-50%); }
  }

  .aliado-item{
    flex:0 0 auto;
    display:flex;
    align-items:center;
    justify-content:center;
    width:170px;
    height:100px;
    margin:0 22px;
    background:#fff;
    border:1px solid #ececf3;
    border-radius:14px;
    box-shadow:0 4px 10px rgba(20,32,107,.05);
    transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    padding:14px;
  }
  .aliado-item img{
    max-width:100%;
    max-height:100%;
    object-fit:contain;
    filter:grayscale(15%);
    transition:filter .3s ease;
  }
  .aliado-item:hover{
    transform:translateY(-6px) scale(1.06);
    box-shadow:0 16px 28px rgba(28,63,174,.18);
    border-color:var(--azul-2);
  }
  .aliado-item:hover img{
    filter:grayscale(0%);
  }

  /* ===== Banner Programas (con estudiante) ===== */
  .hero-programas{
    position:relative;
    overflow:hidden;
    min-height:320px;
    background:linear-gradient(120deg, #0a1a5c 0%, #1c3fae 55%, #2a4fc7 100%);
    display:flex;
    align-items:center;
  }
  .hero-programas .glow{
    position:absolute;
    inset:0;
    pointer-events:none;
    overflow:hidden;
  }
  .hero-programas .glow span{
    position:absolute;
    border-radius:50%;
    filter:blur(2px);
    opacity:.5;
    background:radial-gradient(circle, rgba(255,255,255,.9) 0%, rgba(255,255,255,0) 70%);
    animation:flotar 6s ease-in-out infinite;
  }
  .hero-programas .glow span:nth-child(1){ width:70px; height:70px; top:15%; left:8%; animation-delay:0s; }
  .hero-programas .glow span:nth-child(2){ width:40px; height:40px; top:65%; left:20%; animation-delay:1.2s; }
  .hero-programas .glow span:nth-child(3){ width:55px; height:55px; top:30%; left:92%; animation-delay:.6s; }
  .hero-programas .glow span:nth-child(4){ width:30px; height:30px; top:75%; left:85%; animation-delay:2s; }

  .hero-programas-texto{
    position:relative;
    z-index:2;
    max-width:600px;
    padding:0 60px;
  }
  .hero-programas-tag{
    display:flex;
    align-items:center;
    gap:10px;
    color:var(--amarillo);
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:13px;
    letter-spacing:2px;
    margin-bottom:14px;
  }
  .hero-programas-tag .linea{
    width:26px;
    height:2px;
    background:var(--amarillo);
    display:inline-block;
  }
  .hero-programas-texto h1{
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:38px;
    color:var(--blanco);
    line-height:1.2;
    margin-bottom:16px;
  }
  .hero-programas-texto h1 span{ color:var(--amarillo); }
  .hero-programas-texto p{
    font-family:'Poppins', sans-serif;
    font-size:15px;
    color:#d7dcf5;
    line-height:1.6;
  }

  .hero-programas-img{
    position:absolute;
    right:60px;
    bottom:0;
    height:105%;
    z-index:2;
    max-width:38%;
    object-fit:contain;
  }
  @media (max-width:900px){
    .hero-programas-img{ display:none; }
  }

  /* ===== Grid de escuelas (página Programas) ===== */
  .programas-listado{
    background-color:#fffaf3;
    background-image:radial-gradient(circle, #e7e0d3 1px, transparent 1.6px);
    background-size:18px 18px;
    padding:60px 60px 75px;
  }
  .programas-listado .oferta-tag{ justify-content:flex-start; }
  .programas-listado h2{
    font-family:'Poppins', sans-serif;
    font-weight:700;
    font-size:30px;
    color:#111;
    margin-bottom:36px;
    max-width:640px;
  }

  /* ===== Navegación rápida entre escuelas ===== */
  .escuelas-nav-rapida{
    position:sticky;
    top:0;
    z-index:40;
    background:#0a1230;
    display:flex;
    flex-wrap:wrap;
    gap:8px;
    padding:14px 60px;
    box-shadow:0 4px 12px rgba(0,0,0,.15);
  }
  .escuelas-nav-rapida a{
    font-family:'Poppins', sans-serif;
    font-weight:600;
    font-size:12.5px;
    color:#cfd4ec;
    text-decoration:none;
    padding:8px 14px;
    border-radius:20px;
    border:1px solid rgba(255,255,255,.15);
    transition:background .2s ease, color .2s ease, border-color .2s ease;
    white-space:nowrap;
  }
  .escuelas-nav-rapida a:hover{
    background:var(--amarillo);
    color:#0a1230;
    border-color:var(--amarillo);
  }

  /* Ajuste de scroll para que el ancla no quede tapada por el sticky nav */
  .escuela-header{ scroll-margin-top:70px; }

/* ===== Encabezado de escuela (detalle) ===== */
  .escuela-header{
    background-color:#fffaf3;
    background-image:radial-gradient(circle, #e7e0d3 1px, transparent 1.6px);
    background-size:18px 18px;
    padding:50px 60px 10px;
  }
  .escuela-header h1{
    font-family:'Poppins', sans-serif;
    font-weight:700;
